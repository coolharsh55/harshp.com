{% extends 'template_base.jinja2' %}
{% block pagetitle %}Games{% endblock pagetitle %}
{% block navtype %}| <a href="/hobbies">hobbies</a>{% endblock navtype %}
{% block title_body %}hobbies{% endblock title_body %}
{% block desc %}{% endblock desc %}
{% block content %}
<section id="currently-playing">
  <h2>Games I'm Currently Playing</h2>
  <ol>
    {% for game, title in currently_playing %}
    <li>
      <a href="{{game.iri}}">{{game.schema_name}}</a>
      <small>
        <i>{% if game.hpcom_game_owned_platform%}📦 {{ game.hpcom_game_owned_platform|xjoin }}</i>{% endif %}
        {% if game.hpcom_game_platform_played %} 🎮 {{game.hpcom_game_platform_played|xjoin}}{% endif %}
      </small>
    </li>
    {% endfor %}
  </ol>
</section>

<section id="played">
  <h2>Games I've Played</h2>
  <ol>
    {% for game, title, years in played %}
    <li>
      <a href="/hobbies/games/{{game['hpcom_game_id']}}">{{ title }}</a> <br/>
      <small>
        <i>🕐 {{ years }} | 🎮 {{game.hpcom_game_platform_played|xjoin}}{% if game.hpcom_game_owned_platform%} | 📦 {{ game.hpcom_game_owned_platform|xjoin }}</i>{% endif %}</i>
          {% if game.schema_isPartOf %}<br/>{% if game.schema_isPartOf is sequence %}featured in lists:
            {% for list in game.schema_isPartOf | sort(attribute='schema_identifier') %}<a href="{{list.iri}}">{{list.schema_identifier}}</a>{{ ", " if not loop.last }}{% endfor %}
          {% else %}featured in list:
              <a href="{{game.schema_isPartOf.iri}}">{{game.schema_isPartOf.schema_identifier}}</a>
          {% endif %}{% endif %}
      </small>
    </li>
    {% endfor %}
  </ol>
</section>
{% endblock content %}